{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "DATABASE_URL_UNPOOLED", "BETTER_AUTH_SECRET"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "env": ["BETTER_AUTH_SECRET"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
