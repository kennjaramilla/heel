# Postgres connection string (Neon). Leave unset locally to use the embedded PGlite database in .data/.
DATABASE_URL=
# Any long random string. Required in production.
BETTER_AUTH_SECRET=
# Password for the admin@heel.dev account created by the seed script. Leave unset to skip it.
ADMIN_PASSWORD=
# Vercel Cron sends this as a bearer token to /api/cron/payouts.
CRON_SECRET=
